{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/api/listino?s=:slug"
    },
    {
      "source": "/listino",
      "has": [
        {
          "type": "query",
          "key": "s"
        }
      ],
      "destination": "/api/listino"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]{1,38}[a-z0-9])",
      "destination": "/api/listino?s=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
